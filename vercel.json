{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "clinte/dist",
  "functions": {
    "api/[...all].js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

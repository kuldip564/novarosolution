generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  READ
  ARCHIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

type CloudinaryAsset {
  secureUrl String
  publicId  String?
}

type ProjectResult {
  value String
  label String
}

type PostAuthor {
  name   String
  avatar CloudinaryAsset?
}

model AdminUser {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  slug        String            @unique
  order       Int
  title       String
  category    String
  hook        String
  body        String
  heroTitle   String?
  heroImage   CloudinaryAsset?
  coverClass  String?
  screens     CloudinaryAsset[]
  results     ProjectResult[]
  tags        String[]
  externalUrl String?
  published   Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Service {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  slug             String           @unique
  order            Int
  name             String
  title            String
  description      String
  shortDescription String?
  bullets          String[]
  tags             String[]
  icon             String?
  image            CloudinaryAsset?
  imageAlt         String?
  published        Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Testimonial {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  quote     String
  name      String
  role      String
  avatar    CloudinaryAsset?
  rating    Int              @default(5)
  order     Int
  published Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model TeamMember {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  photo     CloudinaryAsset?
  order     Int
  published Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ClientLogo {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  image     CloudinaryAsset?
  order     Int
  published Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  order     Int
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  key       String   @id @map("_id")
  value     Json
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  services  String[]
  budget    String?
  message   String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Post {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String           @unique
  excerpt         String
  coverImage      CloudinaryAsset?
  content         String
  category        String
  tags            String[]
  author          PostAuthor
  status          PostStatus       @default(DRAFT)
  publishedAt     DateTime?
  readingTime     Int              @default(1)
  metaTitle       String?
  metaDescription String?
  ogImage         CloudinaryAsset?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

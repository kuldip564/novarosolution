
PORT=5001
NODE_ENV=development


CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3004


# MongoDB — required for admin panel and CMS content
# Atlas (recommended for production):
# DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/novaro?retryWrites=true&w=majority"
# Local replica set (Prisma + transactions for upsert — use rs.initiate() once):
# DATABASE_URL="mongodb://127.0.0.1:27017/novaro?replicaSet=rs0"
# Local standalone (no replica set — supported; admin sync uses find/update/create):
# DATABASE_URL="mongodb://127.0.0.1:27017/novaro"
DATABASE_URL="mongodb://127.0.0.1:27017/novaro?replicaSet=rs0"

# Auth — admin login credentials (synced on every server start + seed)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@novarosolution.com
ADMIN_PASSWORD=ChangeMeNow!123

# Cloudinary (recommended for production; optional in local dev — falls back to /uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional in development — required when SMTP is wired)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# MAIL_TO=novaro@novarosolution.com
# MAIL_FROM=website@novarosolution.com

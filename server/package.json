{
  "name": "novaro-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "start:prod": "NODE_ENV=production node index.js",
    "build:client": "npm --prefix ../next-client run build",
    "vercel-build": "npm --prefix ../next-client install && npm run build:client",
    "build": "npm run build:client",
    "migrate:local-to-atlas": "node scripts/migrate-local-to-atlas.js",
    "sync:site-content": "node scripts/temp-upload-sitecontent.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0",
    "xlsx": "^0.18.5"
  }
}
